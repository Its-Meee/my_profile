---
import { siteConfig } from "../config";

const skillGroups = Object.entries(siteConfig.skills ?? {});
const hasSkills = skillGroups.length > 0;
---

{
  hasSkills && (
    <section id="skills" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900 dark:text-white">
              Skills
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-6">
              {skillGroups.map(([category, skills]) => (
                <div class="rounded-2xl border border-gray-200 bg-white p-5 sm:p-6 shadow-sm transition-colors duration-300 dark:border-slate-800 dark:bg-slate-900">
                  <h3
                    class="text-base sm:text-lg font-semibold tracking-wide"
                    style={`color: ${siteConfig.accentColor}`}
                  >
                    {category}
                  </h3>
                  <div class="mt-4 flex flex-wrap gap-2.5">
                    {skills.map((skill) => (
                      <span class="rounded-full bg-gray-100 px-3 py-1.5 text-sm font-medium text-gray-800 transition-colors duration-200 dark:bg-slate-800 dark:text-slate-200">
                        {skill}
                      </span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
