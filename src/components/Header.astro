---
import { siteConfig } from "../config";

const hasSkills = siteConfig.skills && Object.keys(siteConfig.skills).length > 0;
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

<header
  id="header"
  class="fixed top-0 left-0 right-0 z-50 hidden md:block transition-all duration-300"
>
  <nav class="relative max-w-7xl mx-auto px-8 py-4">
    <ul class="flex items-center gap-8 justify-center">
      <li>
        <a
          href="#about"
          class="text-gray-700 hover:text-black dark:text-slate-300 dark:hover:text-white transition-colors font-medium"
        >
          About
        </a>
      </li>
      {
        hasSkills && (
          <li>
            <a
              href="#skills"
              class="text-gray-700 hover:text-black dark:text-slate-300 dark:hover:text-white transition-colors font-medium"
            >
              Skills
            </a>
          </li>
        )
      }
      {
        hasExperience && (
          <li>
            <a
              href="#experience"
              class="text-gray-700 hover:text-black dark:text-slate-300 dark:hover:text-white transition-colors font-medium"
            >
              Experience
            </a>
          </li>
        )
      }
      {
        hasEducation && (
          <li>
            <a
              href="#education"
              class="text-gray-700 hover:text-black dark:text-slate-300 dark:hover:text-white transition-colors font-medium"
            >
              Education
            </a>
          </li>
        )
      }
      <li>
        <a
          href="#contact"
          class="text-gray-700 hover:text-black dark:text-slate-300 dark:hover:text-white transition-colors font-medium"
        >
          Contact
        </a>
      </li>
    </ul>
    <button
      id="theme-toggle"
      type="button"
      aria-label="Toggle theme"
      class="absolute right-8 top-1/2 inline-flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full border border-gray-200 bg-white/70 text-gray-700 transition-all duration-300 hover:border-gray-300 hover:text-black dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-300 dark:hover:border-slate-500 dark:hover:text-white"
    >
      <svg
        class="h-5 w-5 dark:hidden"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2"></path>
        <path d="M12 20v2"></path>
        <path d="m4.93 4.93 1.41 1.41"></path>
        <path d="m17.66 17.66 1.41 1.41"></path>
        <path d="M2 12h2"></path>
        <path d="M20 12h2"></path>
        <path d="m6.34 17.66-1.41 1.41"></path>
        <path d="m19.07 4.93-1.41 1.41"></path>
      </svg>
      <svg
        class="hidden h-5 w-5 dark:block"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1 -9 -9"></path>
      </svg>
    </button>
  </nav>
</header>

<script>
  const root = document.documentElement;
  const themeToggle = document.getElementById("theme-toggle");

  const updateTheme = (theme) => {
    root.classList.toggle("dark", theme === "dark");
    localStorage.setItem("theme", theme);
  };

  themeToggle?.addEventListener("click", () => {
    updateTheme(root.classList.contains("dark") ? "light" : "dark");
  });

  window.addEventListener("scroll", () => {
    const header = document.getElementById("header");
    if (window.scrollY > 100) {
      header?.classList.add("bg-white/80", "dark:bg-slate-950/75", "backdrop-blur-sm");
    } else {
      header?.classList.remove("bg-white/80", "dark:bg-slate-950/75", "backdrop-blur-sm");
    }
  });
</script>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>
